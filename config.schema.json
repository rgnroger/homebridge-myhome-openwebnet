{
  "pluginAlias": "MyHomeOpenWebNet",
  "pluginType": "platform",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "MyHome OpenWebNet",
        "required": true
      },
      "host": {
        "title": "Gateway IP Address",
        "type": "string",
        "placeholder": "192.168.1.100",
        "required": true
      },
      "port": {
        "title": "OpenWebNet Port",
        "type": "integer",
        "default": 20000,
        "minimum": 1,
        "maximum": 65535,
        "required": true
      },
      "password": {
        "title": "Password",
        "type": "string",
        "default": "",
        "required": false
      }
    }
  },
  "layout": [
    "name",
    "host",
    "port",
    "password"
  ]
}