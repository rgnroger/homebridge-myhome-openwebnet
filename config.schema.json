{
  "pluginAlias": "MyHomeOpenWebNet",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": ["name", "host", "port"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Nome do plugin",
        "type": "string",
        "default": "MyHome OpenWebNet",
        "required": true
      },
      "host": {
        "title": "IP do gateway MyHome",
        "type": "string",
        "placeholder": "192.168.0.23",
        "required": true
      },
      "port": {
        "title": "Porta OpenWebNet",
        "type": "integer",
        "default": 20000,
        "minimum": 1,
        "maximum": 65535,
        "required": true
      },
      "password": {
        "title": "Senha OpenWebNet",
        "type": "string",
        "default": "12345",
        "required": false
      },
      "lights": {
        "title": "Luzes",
        "description": "Adicione as luzes instaladas no sistema MyHome.",
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "title": "Luz",
          "required": ["name", "area", "point", "bus"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Nome da luz",
              "type": "string",
              "placeholder": "Ex.: Luz da sala",
              "required": true
            },
            "area": {
              "title": "Ambiente (A)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "point": {
              "title": "Ponto de luz (PL)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "bus": {
              "title": "BUS (B)",
              "description": "Normalmente 0.",
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "maximum": 99,
              "required": true
            }
          }
        }
      },
      "dimmers": {
        "title": "Dimmers",
        "description": "Adicione as luzes com controle de intensidade.",
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "title": "Dimmer",
          "required": ["name", "area", "point", "bus"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Nome do dimmer",
              "type": "string",
              "placeholder": "Ex.: Luz da sala",
              "required": true
            },
            "area": {
              "title": "Ambiente (A)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "point": {
              "title": "Ponto de luz (PL)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "bus": {
              "title": "BUS (B)",
              "description": "Normalmente 0.",
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "maximum": 99,
              "required": true
            }
          }
        }
      }
    }
  },
  "layout": [
    "name",
    "host",
    "port",
    "password",
    {
      "key": "lights",
      "type": "array",
      "name": " ",
      "description": "Cadastre cada ponto de luz do sistema MyHome.",
      "orderable": true,
      "buttonText": "Adicionar luz",
      "items": [
        "lights[].name",
        "lights[].area",
        "lights[].point",
        "lights[].bus"
      ]
    },
    {
      "key": "dimmers",
      "type": "array",
      "name": " ",
      "description": "Cadastre cada dimmer do sistema MyHome.",
      "orderable": true,
      "buttonText": "Adicionar dimmer",
      "items": [
        "dimmers[].name",
        "dimmers[].area",
        "dimmers[].point",
        "dimmers[].bus"
      ]
    }
  ]
}
